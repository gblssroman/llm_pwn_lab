DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/llm_convo
OPENAI_API_KEY=

# Optional. `./scripts/init-langfuse.sh` creates .env.langfuse with real values.
# The service remains functional when Langfuse is not configured.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:8992
LANGFUSE_PUBLIC_URL=http://localhost:8992
LANGFUSE_PROJECT_ID=llm-convo-platform
LANGFUSE_TRACING_ENVIRONMENT=development

APP_PORT=8990

LOG_LEVEL=INFO
DATABASE_AUTO_CREATE=true
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=180
WORKER_HEARTBEAT_SECONDS=30
MAX_CONCURRENT_CONVERSATIONS=10

# Optional vm_master_stand integration. Keep both tokens server-side and distinct.
VM_MASTER_BASE_URL=
VM_MASTER_EVALUATOR_TOKEN=
VM_MASTER_SANDBOX_TOKEN=
VM_MASTER_REQUEST_TIMEOUT_SECONDS=30
VM_MASTER_JOB_POLL_SECONDS=1
VM_MASTER_JOB_TIMEOUT_SECONDS=1200
